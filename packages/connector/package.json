{
	"name": "mason-connector",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DenisSud/mason.git"
	},
	"version": "0.1.0",
	"description": "The TypeScript SDK for a mason connector: the WebSocket runtime, negotiation, durable deduplication and outbound replay, attachments, MCP helpers, and the fake-Mason conformance suite.",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testkit": {
			"source": "./src/testkit/index.ts",
			"types": "./dist/testkit/index.d.ts",
			"import": "./dist/testkit/index.js"
		},
		"./store/memory": {
			"source": "./src/store-memory.ts",
			"types": "./dist/store-memory.d.ts",
			"import": "./dist/store-memory.js"
		},
		"./store/sqlite": {
			"source": "./src/store-sqlite.ts",
			"types": "./dist/store-sqlite.d.ts",
			"import": "./dist/store-sqlite.js"
		},
		"./mcp": {
			"source": "./src/mcp.ts",
			"types": "./dist/mcp.d.ts",
			"import": "./dist/mcp.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"mason-protocol": "0.1.0"
	},
	"engines": {
		"node": ">=22.6"
	}
}
