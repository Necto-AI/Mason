  },
  "dependencies": {
    "@jetbrains/websandbox": "1.2.1",
    "esbuild": "0.28.2",
    "marked": "15.0.7",
    "partial-json": "0.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typebox": "1.3.27",
    "ws": "8.18.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1"
  }
}
