{
	"name": "mason-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "node --experimental-strip-types src/server/main.ts",
		"dev:stack": "node --experimental-strip-types scripts/dev-stack.ts",
		"build:web": "node scripts/build-web.mjs",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"test:packages": "node --experimental-strip-types --experimental-sqlite --test packages/protocol/test/*.test.ts packages/connector/test/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"gen:surface": "node --experimental-strip-types scripts/gen-surface.ts",
		"prompt": "node --experimental-strip-types scripts/prompt.ts",
		"gen:surface:check": "node --experimental-strip-types scripts/gen-surface.ts --check",
		"check:docs": "node --experimental-strip-types scripts/doc-budget.ts --check",
		"build:packages": "npm run build --workspace mason-protocol && npm run build --workspace mason-connector",
		"prove:connector": "node --experimental-strip-types scripts/prove-connector-sdk.ts",
		"lint": "node scripts/biome.mjs check .",
		"lint:write": "node scripts/biome.mjs check --write .",
		"eval": "node --experimental-strip-types evals/run.ts",
		"eval:judge": "node --experimental-strip-types evals/judge.ts",
		"token": "node --experimental-strip-types scripts/token.ts",
		"integration": "node --experimental-strip-types scripts/integration.ts",
		"connector": "node --experimental-strip-types scripts/connector.ts",
		"doctor": "node --experimental-strip-types scripts/doctor.ts",
		"test:asr": "asr/run.sh asr/.venv/bin/python -m unittest discover -s asr/tests -v",
		"pretest": "npm run build:packages",
		"predev": "npm run build:packages",
		"pregen:surface": "npm run build:packages"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-codemode": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-env": "1.5.0",
		"@earendil-works/pi-mcp": "1.5.0",
		"@jetbrains/websandbox": "1.2.1",
		"esbuild": "0.28.2",
		"marked": "15.0.7",
		"partial-json": "0.1.7",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/ws": "8.18.1",
		"typescript": "5.9.3"
	}
}
