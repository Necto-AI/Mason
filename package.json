{
  "name": "mason",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/link-vendor.mjs && node scripts/verify-vendor.mjs",
    "dev": "node --conditions=source --experimental-strip-types src/server/main.ts",
    "dev:stack": "node --conditions=source --experimental-strip-types scripts/dev-stack.ts",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --conditions=source --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/biome.mjs check .",
    "lint:write": "node scripts/biome.mjs check --write .",
    "eval": "node --conditions=source --experimental-strip-types evals/run.ts",
    "eval:judge": "node --conditions=source --experimental-strip-types evals/judge.ts",
    "token": "node --conditions=source --experimental-strip-types scripts/token.ts",
    "team": "node --conditions=source --experimental-strip-types scripts/team.ts",
    "integration": "node --conditions=source --experimental-strip-types scripts/integration.ts",
    "doctor": "node --conditions=source --experimental-strip-types scripts/doctor.ts",
    "test:asr": "asr/run.sh asr/.venv/bin/python -m unittest discover -s asr/tests -v"
  },
  "dependencies": {
    "@jetbrains/websandbox": "1.2.1",
    "esbuild": "0.28.2",
    "marked": "15.0.7",
    "partial-json": "0.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "ws": "8.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
